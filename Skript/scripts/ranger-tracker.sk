# ============================================================
#  Ranger Tracker Spec  –  Bellcraft Classes
#  Requires: Skript 2.7+
#
#  Console hooks (MythicMobs/skills/RangerTracker.yml):
#    bellcraft-tracker track-prey <player>
#    bellcraft-tracker hunt-mark <player>
#    bellcraft-tracker structure-sense <player>
#    bellcraft-tracker trailfinder <player>
#
#  Admin stub until the creative→survival structure registry ships:
#    /bellcraft-structure add <id> [name]
#    /bellcraft-structure list
#    /bellcraft-structure remove <id>
#
#  Contract: config/tracker/structure-registry.yml
#  TODO(structure-registry): replace {bellcraft.structures.*} with the
#  authored index (PAPI / Mythic targeter / config loader).
# ============================================================

options:
    prefix: &8[&b&lBellcraft&8] &7
    track_range: 48
    track_duration: 8
    mark_duration: 8
    mark_damage_bonus: 1.15
    structure_range: 96
    trailfinder_range: 160
    trailfinder_duration: 16
    party_share_radius: 32

# ── Skill hooks (console only; fired by MythicMobs) ──────────

command /bellcraft-tracker [<text>] [<text>]:
    permission: bellcraft.admin.grantsp
    executable by: console
    trigger:
        if arg-1 is not set:
            stop
        if arg-2 is not set:
            stop

        set {_player} to arg-2 parsed as player
        if {_player} is not set:
            stop
        if {_player} is not online:
            stop

        if arg-1 is "track-prey":
            trackerTrackPrey({_player}, {@track_range}, {@track_duration})
            stop
        if arg-1 is "hunt-mark":
            trackerHuntMark({_player}, {@mark_duration})
            stop
        if arg-1 is "structure-sense":
            trackerStructurePing({_player}, {@structure_range}, {@track_duration}, false)
            stop
        if arg-1 is "trailfinder":
            trackerTrailfinder({_player})
            stop

# ── Track Prey: nearest other player or named living entity ──

function trackerTrackPrey(p: player, range: number, duration: number):
    set {_target} to trackerFindPrey({_p}, {_range})
    if {_target} is not set:
        send "{@prefix}&7No hostile players or named NPCs within &e%{_range}% &7blocks." to {_p}
        stop

    add "bellcraft_tracking" to scoreboard tags of {_p}
    apply potion of speed of tier 1 to {_p} for {_duration} seconds
    apply potion of glowing of tier 1 to {_target} for {_duration} seconds
    set compass target of {_p} to location of {_target}

    set {_name} to trackerEntityName({_target})
    set {_dist} to distance between {_p} and {_target}
    send "{@prefix}&6Track Prey &7locked onto &e%{_name}% &8(&e%{_dist}%m&8)." to {_p}

    wait {_duration} seconds
    if {_p} is online:
        remove "bellcraft_tracking" from scoreboard tags of {_p}

function trackerFindPrey(p: player, range: number) :: entity:
    set {_best} to 99999
    loop all players in radius {_range} around {_p}:
        if loop-player is not {_p}:
            set {_d} to distance between {_p} and loop-player
            if {_d} < {_best}:
                set {_best} to {_d}
                set {_found} to loop-player
    loop all living entities in radius {_range} around {_p}:
        if loop-entity is not a player:
            set {_label} to custom name of loop-entity
            if {_label} is set:
                if {_label} is not "":
                    set {_d} to distance between {_p} and loop-entity
                    if {_d} < {_best}:
                        set {_best} to {_d}
                        set {_found} to loop-entity
    return {_found}

function trackerEntityName(e: entity) :: text:
    if {_e} is a player:
        return "%{_e}%"
    set {_label} to custom name of {_e}
    if {_label} is set:
        if {_label} is not "":
            return {_label}
    return "unknown prey"

# ── Hunt Mark: glow through walls, trail, bonus damage ───────

function trackerHuntMark(p: player, duration: number):
    set {_target} to targeted entity of {_p}
    if {_target} is not set:
        set {_target} to trackerFindPrey({_p}, {@track_range})
    if {_target} is not set:
        send "{@prefix}&7Hunt Mark needs a target in sight (or nearby prey)." to {_p}
        stop

    set {_id} to "%uuid of {_target}%"
    if {_id} is "":
        send "{@prefix}&7Hunt Mark cannot lock that target." to {_p}
        stop

    set {bellcraft.huntmark.expire::%{_id}%} to now + {_duration} seconds
    set {bellcraft.huntmark.caster::%{_id}%} to "%uuid of {_p}%"
    set {bellcraft.huntmark.entity::%{_id}%} to {_target}
    if {bellcraft.huntmark.ids::*} does not contain {_id}:
        add {_id} to {bellcraft.huntmark.ids::*}
    add "bellcraft_hunt_marked" to scoreboard tags of {_target}

    apply potion of glowing of tier 1 to {_target} for {_duration} seconds
    set compass target of {_p} to location of {_target}

    set {_name} to trackerEntityName({_target})
    send "{@prefix}&cHunt Mark &7branded &e%{_name}%&7. They are visible through walls." to {_p}

on damage:
    attacker is a player
    victim is a living entity
    set {_vid} to "%uuid of victim%"
    if {bellcraft.huntmark.expire::%{_vid}%} is not set:
        stop
    if {bellcraft.huntmark.expire::%{_vid}%} < now:
        stop
    if {bellcraft.huntmark.caster::%{_vid}%} is not "%uuid of attacker%":
        stop
    set damage to damage * {@mark_damage_bonus}

every 10 ticks:
    if {bellcraft.huntmark.ids::*} is not set:
        stop
    loop {bellcraft.huntmark.ids::*}:
        set {_id} to loop-value
        if {bellcraft.huntmark.expire::%{_id}%} is not set:
            delete {bellcraft.huntmark.entity::%{_id}%}
            remove {_id} from {bellcraft.huntmark.ids::*}
        else if {bellcraft.huntmark.expire::%{_id}%} < now:
            set {_marked} to {bellcraft.huntmark.entity::%{_id}%}
            if {_marked} is set:
                remove "bellcraft_hunt_marked" from scoreboard tags of {_marked}
            delete {bellcraft.huntmark.expire::%{_id}%}
            delete {bellcraft.huntmark.caster::%{_id}%}
            delete {bellcraft.huntmark.entity::%{_id}%}
            remove {_id} from {bellcraft.huntmark.ids::*}
        else:
            set {_marked} to {bellcraft.huntmark.entity::%{_id}%}
            if {_marked} is set:
                play smoke at {_marked}
                play crit at {_marked}

# ── Structure Sense / Trailfinder ─────────────────────────────

function trackerTrailfinder(p: player):
    add "bellcraft_tracking" to scoreboard tags of {_p}
    apply potion of speed of tier 1 to {_p} for {@trailfinder_duration} seconds
    set {_hit} to trackerStructurePing({_p}, {@trailfinder_range}, {@trailfinder_duration}, true)
    if {_hit} is false:
        # Fall back to a long-range NPC / player ping if no structure is indexed.
        trackerTrackPrey({_p}, {@trailfinder_range}, {@trailfinder_duration})
        stop
    wait {@trailfinder_duration} seconds
    if {_p} is online:
        remove "bellcraft_tracking" from scoreboard tags of {_p}

function trackerStructurePing(p: player, range: number, duration: number, share: boolean) :: boolean:
    # TODO(structure-registry): scan marker entities tagged bellcraft_structure
    # once the spawn pipeline places them in survival worlds.
    set {_best} to 99999
    loop {bellcraft.structures.ids::*}:
        set {_sid} to loop-value
        set {_world} to {bellcraft.structures.world::%{_sid}%}
        if {_world} is world of {_p}:
            set {_loc} to location({bellcraft.structures.x::%{_sid}%}, {bellcraft.structures.y::%{_sid}%}, {bellcraft.structures.z::%{_sid}%}, {_world})
            if {_loc} is set:
                set {_d} to distance between {_p} and {_loc}
                if {_d} <= {_range}:
                    if {_d} < {_best}:
                        set {_best} to {_d}
                        set {_id} to {_sid}
                        set {_found} to {_loc}

    if {_found} is not set:
        send "{@prefix}&eStructure Sense &7found no registered structures in range." to {_p}
        send "{@prefix}&8Registry stub empty. Admins: /bellcraft-structure add <id>" to {_p}
        send "{@prefix}&8Handoff: config/tracker/structure-registry.yml" to {_p}
        return false

    set {_name} to {bellcraft.structures.name::%{_id}%}
    if {_name} is not set:
        set {_name} to {_id}
    set compass target of {_p} to {_found}
    send "{@prefix}&eStructure Sense &7locked onto &6%{_name}% &8(&e%{_best}%m&8)." to {_p}
    play end rod at {_found}

    if {_share} is true:
        # Nearby-ally share until an MMOCore party iterator is wired.
        # TODO(structure-registry): share with party members instead of radius.
        loop all players in radius {@party_share_radius} around {_p}:
            if loop-player is not {_p}:
                set compass target of loop-player to {_found}
                send "{@prefix}&6Trailfinder &7shared &6%{_name}% &7(&e%{_best}%m&7) from &e%{_p}%&7." to loop-player
    return true

# ── Admin structure index (runtime stub) ──────────────────────

command /bellcraft-structure [<text>] [<text>] [<text>]:
    permission: op
    trigger:
        if arg-1 is not set:
            send "{@prefix}&7Usage: /bellcraft-structure add <id> [name] | list | remove <id>" to player
            stop

        if arg-1 is "list":
            if {bellcraft.structures.ids::*} is not set:
                send "{@prefix}&7No stub structures registered." to player
                stop
            send "{@prefix}&6Registered structures:" to player
            loop {bellcraft.structures.ids::*}:
                set {_sid} to loop-value
                set {_n} to {bellcraft.structures.name::%{_sid}%}
                set {_w} to {bellcraft.structures.world::%{_sid}%}
                set {_x} to {bellcraft.structures.x::%{_sid}%}
                set {_y} to {bellcraft.structures.y::%{_sid}%}
                set {_z} to {bellcraft.structures.z::%{_sid}%}
                send "&8- &e%{_sid}% &7%{_n}% &8(%{_w}% %{_x}%, %{_y}%, %{_z}%)" to player
            stop

        if arg-1 is "remove":
            if arg-2 is not set:
                send "{@prefix}&cSpecify an id to remove." to player
                stop
            remove arg-2 from {bellcraft.structures.ids::*}
            delete {bellcraft.structures.world::%arg-2%}
            delete {bellcraft.structures.x::%arg-2%}
            delete {bellcraft.structures.y::%arg-2%}
            delete {bellcraft.structures.z::%arg-2%}
            delete {bellcraft.structures.name::%arg-2%}
            send "{@prefix}&7Removed structure &e%arg-2%&7." to player
            stop

        if arg-1 is "add":
            if arg-2 is not set:
                send "{@prefix}&cUsage: /bellcraft-structure add <id> [display name]" to player
                stop
            set {_id} to arg-2
            if arg-3 is set:
                set {_name} to arg-3
            else:
                set {_name} to {_id}
            if {bellcraft.structures.ids::*} does not contain {_id}:
                add {_id} to {bellcraft.structures.ids::*}
            set {bellcraft.structures.world::%{_id}%} to world of player
            set {bellcraft.structures.x::%{_id}%} to x-coordinate of player
            set {bellcraft.structures.y::%{_id}%} to y-coordinate of player
            set {bellcraft.structures.z::%{_id}%} to z-coordinate of player
            set {bellcraft.structures.name::%{_id}%} to {_name}
            send "{@prefix}&aRegistered &e%{_id}% &7(&6%{_name}%&7) at your location." to player
            send "{@prefix}&8Stub only — replace with config/tracker/structure-registry.yml loader." to player
            stop

        send "{@prefix}&7Usage: /bellcraft-structure add <id> [name] | list | remove <id>" to player
