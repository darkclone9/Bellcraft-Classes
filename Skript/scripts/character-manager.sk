# ============================================================
#  Character Manager  –  Switch, Rename, and Icon
#  Requires: Skript 2.7+, PlaceholderAPI, skript-placeholders,
#            MMOProfiles
#
#  Why this exists
#  ---------------
#  MMOProfiles has no player command to rename a profile or
#  change its selection-GUI icon after creation (open GitLab
#  suggestion phoenix-dvpmt/mmoprofiles#71). True hot-swap
#  without unloading is unsafe: inventory, location, and
#  MMOCore data are profile-bound and must be saved first.
#
#  The supported switch path is the official quit flow:
#      /mmoprofiles quit <player>
#  which saves/unloads the current profile, teleports to the
#  profile-selection location, and reopens "Choose Your
#  Character" (see MMOProfiles config quit_profile).
#
#  Rename + icon are stored in persistent Skript variables and
#  overlaid onto the MMOProfiles selection GUI so players see
#  them when picking a character. The internal MMOProfiles
#  name is unchanged because the plugin exposes no setter.
#
#  Commands
#    /characters       (aliases: chars, switchprofile)
#    /renamecharacter  (alias: renamechar)
#    /changeicon       (alias: charicon)
#  Also opened from the /p "Your Character" GUI.
# ============================================================

options:
    prefix: &8[&d&lCharacters&8] &7
    menu-title: "&8&lYour Characters"
    confirm-title: "&8&lSwitch Character?"
    icon-title: "&8&lChoose an Icon"
    select-title: "Choose Your Character"
    max-name-length: 20
    min-name-length: 2
    switch-delay-ticks: 15
    rename-timeout: 30

# -------------------------------------------------------
#  Lookups
# -------------------------------------------------------
function charOfficialName(p: player) :: text:
    set {_n} to placeholder "mmoprofiles_current_profile_name" from {_p}
    if {_n} is not set:
        return ""
    if {_n} is "":
        return ""
    if {_n} contains "mmoprofiles_current_profile_name":
        return ""
    return {_n}

function charHasProfile(p: player) :: boolean:
    set {_n} to charOfficialName({_p})
    if {_n} is "":
        return false
    return true

function charDisplayName(p: player) :: text:
    set {_official} to charOfficialName({_p})
    if {_official} is "":
        return "Unknown"
    set {_uuid} to {_p}'s uuid
    if {char::display::%{_uuid}%::%{_official}%} is set:
        return {char::display::%{_uuid}%::%{_official}%}
    return {_official}

function charIconIdOf(p: player) :: text:
    set {_official} to charOfficialName({_p})
    if {_official} is "":
        return "head"
    set {_uuid} to {_p}'s uuid
    if {char::icon::%{_uuid}%::%{_official}%} is set:
        return {char::icon::%{_uuid}%::%{_official}%}
    return "head"

function charIconItem(id: text) :: item:
    if {_id} is "sword":
        return iron sword
    if {_id} is "pearl":
        return ender pearl
    if {_id} is "amethyst":
        return amethyst shard
    if {_id} is "lamp":
        return redstone lamp
    if {_id} is "star":
        return nether star
    if {_id} is "shield":
        return shield
    if {_id} is "bow":
        return bow
    if {_id} is "blaze":
        return blaze rod
    if {_id} is "apple":
        return golden apple
    if {_id} is "diamond":
        return diamond
    if {_id} is "gold":
        return gold ingot
    if {_id} is "lapis":
        return lapis lazuli
    if {_id} is "netherite":
        return netherite ingot
    if {_id} is "bell":
        return bell
    if {_id} is "compass":
        return compass
    if {_id} is "clock":
        return clock
    if {_id} is "nametag":
        return name tag
    if {_id} is "enderchest":
        return ender chest
    if {_id} is "totem":
        return totem of undying
    if {_id} is "elytra":
        return elytra
    if {_id} is "trident":
        return trident
    if {_id} is "creeper":
        return creeper head
    if {_id} is "skeleton":
        return skeleton skull
    if {_id} is "zombie":
        return zombie head
    if {_id} is "dragon":
        return dragon head
    if {_id} is "wither":
        return wither skeleton skull
    return player head

function charIconLabel(id: text) :: text:
    if {_id} is "sword":
        return "Soldier (Iron Sword)"
    if {_id} is "pearl":
        return "Operative (Ender Pearl)"
    if {_id} is "amethyst":
        return "Mystic (Amethyst)"
    if {_id} is "lamp":
        return "Technomancer (Redstone Lamp)"
    if {_id} is "star":
        return "Envoy (Nether Star)"
    if {_id} is "shield":
        return "Paladin (Shield)"
    if {_id} is "bow":
        return "Ranger (Bow)"
    if {_id} is "blaze":
        return "Sorcerer (Blaze Rod)"
    if {_id} is "apple":
        return "Cleric (Golden Apple)"
    if {_id} is "diamond":
        return "Diamond"
    if {_id} is "gold":
        return "Gold"
    if {_id} is "lapis":
        return "Lapis"
    if {_id} is "netherite":
        return "Netherite"
    if {_id} is "bell":
        return "Bell"
    if {_id} is "compass":
        return "Compass"
    if {_id} is "clock":
        return "Clock"
    if {_id} is "nametag":
        return "Name Tag"
    if {_id} is "enderchest":
        return "Ender Chest"
    if {_id} is "totem":
        return "Totem"
    if {_id} is "elytra":
        return "Elytra"
    if {_id} is "trident":
        return "Trident"
    if {_id} is "creeper":
        return "Creeper Head"
    if {_id} is "skeleton":
        return "Skeleton Skull"
    if {_id} is "zombie":
        return "Zombie Head"
    if {_id} is "dragon":
        return "Dragon Head"
    if {_id} is "wither":
        return "Wither Skull"
    return "Default Head"

function charIconIdFromSlot(slot: number) :: text:
    if {_slot} is 0:
        return "head"
    if {_slot} is 1:
        return "sword"
    if {_slot} is 2:
        return "pearl"
    if {_slot} is 3:
        return "amethyst"
    if {_slot} is 4:
        return "lamp"
    if {_slot} is 5:
        return "star"
    if {_slot} is 6:
        return "shield"
    if {_slot} is 7:
        return "bow"
    if {_slot} is 8:
        return "blaze"
    if {_slot} is 9:
        return "apple"
    if {_slot} is 10:
        return "diamond"
    if {_slot} is 11:
        return "gold"
    if {_slot} is 12:
        return "lapis"
    if {_slot} is 13:
        return "netherite"
    if {_slot} is 14:
        return "bell"
    if {_slot} is 15:
        return "compass"
    if {_slot} is 16:
        return "clock"
    if {_slot} is 17:
        return "nametag"
    if {_slot} is 18:
        return "creeper"
    if {_slot} is 19:
        return "skeleton"
    if {_slot} is 20:
        return "zombie"
    if {_slot} is 21:
        return "dragon"
    if {_slot} is 22:
        return "wither"
    if {_slot} is 23:
        return "enderchest"
    if {_slot} is 24:
        return "totem"
    if {_slot} is 25:
        return "elytra"
    if {_slot} is 26:
        return "trident"
    return ""

function charResolveOfficial(uuid: text, shown: text) :: text:
    if {char::official::%{_uuid}%::%{_shown}%} is set:
        return {char::official::%{_uuid}%::%{_shown}%}
    return {_shown}

function charShownNameFor(uuid: text, official: text) :: text:
    if {char::display::%{_uuid}%::%{_official}%} is set:
        return {char::display::%{_uuid}%::%{_official}%}
    return {_official}

function charExtractShownName(t: text) :: text:
    set {_t} to uncolored {_t}
    replace all " (Current)" with "" in {_t}
    replace regex "^\[[^\]]*\]\s*" in {_t} with ""
    replace regex "^\s+" in {_t} with ""
    replace regex "\s+$" in {_t} with ""
    return {_t}

function charIsProfileItem(i: item) :: boolean:
    if {_i} is not set:
        return false
    set {_type} to "%type of {_i}%"
    if {_type} contains "glass pane":
        return false
    if {_type} is "emerald":
        return false
    if {_type} is "redstone":
        return false
    if {_type} is "barrier":
        return false
    set {_name} to uncolored name of {_i}
    if {_name} contains "Create New":
        return false
    if {_name} contains "Slot":
        return false
    if {_name} contains "[":
        if {_name} contains "]":
            return true
    return false

function charNameBlocked(n: text) :: boolean:
    set {_t} to lowercase {_n}
    replace all " " with "" in {_t}
    replace all "_" with "" in {_t}
    replace all "-" with "" in {_t}
    replace all "'" with "" in {_t}
    if {_t} is "admin" or {_t} is "administrator" or {_t} is "owner" or {_t} is "console" or {_t} is "moderator" or {_t} is "staff" or {_t} is "operator" or {_t} is "server":
        return true
    if {_t} contains "fuck" or {_t} contains "shit" or {_t} contains "bitch" or {_t} contains "cunt" or {_t} contains "nigger" or {_t} contains "nigga" or {_t} contains "faggot" or {_t} contains "retard" or {_t} contains "whore" or {_t} contains "slut" or {_t} contains "rape" or {_t} contains "nazi" or {_t} contains "hitler" or {_t} contains "pedo" or {_t} contains "porn" or {_t} contains "dick" or {_t} contains "pussy" or {_t} contains "cock":
        return true
    return false

function charNameTaken(p: player, official: text, candidate: text) :: boolean:
    set {_uuid} to {_p}'s uuid
    set {_cand} to lowercase {_candidate}
    loop 15 times:
        set {_pn} to placeholder "mmoprofiles_profile_name_%loop-number%" from {_p}
        if {_pn} is set:
            if {_pn} is not "":
                if {_pn} does not contain "mmoprofiles_profile_name":
                    set {_shown} to charShownNameFor({_uuid}, {_pn})
                    if lowercase {_shown} is {_cand}:
                        if {_pn} is not {_official}:
                            return true
                    if lowercase {_pn} is {_cand}:
                        if {_pn} is not {_official}:
                            return true
    return false

function charBeginRename(p: player) :: number:
    add 1 to {char::rename-gen::%{_p}'s uuid%}
    set {_gen} to {char::rename-gen::%{_p}'s uuid%}
    set {char::awaiting-rename::%{_p}'s uuid%} to true
    send "{@prefix}&eType a new name for &f%charDisplayName({_p})%&e." to {_p}
    send "{@prefix}&7{@min-name-length}-{@max-name-length} characters. Type &ccancel &7to abort." to {_p}
    return {_gen}

function charFinishRenameTimeout(p: player, gen: number):
    if {char::awaiting-rename::%{_p}'s uuid%} is true:
        if {char::rename-gen::%{_p}'s uuid%} is {_gen}:
            delete {char::awaiting-rename::%{_p}'s uuid%}
            send "{@prefix}&7Rename timed out." to {_p}

# -------------------------------------------------------
#  Overlay the official MMOProfiles selection GUI
# -------------------------------------------------------
function charApplySelectOverlay(p: player):
    if {_p} is not set:
        stop
    set {_title} to uncolored "%name of {_p}'s current inventory%"
    if {_title} is not {@select-title}:
        stop
    set {_uuid} to {_p}'s uuid
    set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24 and 25
    loop {_slots::*}:
        set {_guiSlot} to loop-value
        set {_item} to slot {_guiSlot} of {_p}'s current inventory
        if charIsProfileItem({_item}) is true:
            set {_rawName} to name of {_item}
            set {_shown} to charExtractShownName({_rawName})
            if {_shown} is not "":
                set {_official} to charResolveOfficial({_uuid}, {_shown})
                set {_display} to charShownNameFor({_uuid}, {_official})
                set {_iconId} to "head"
                if {char::icon::%{_uuid}%::%{_official}%} is set:
                    set {_iconId} to {char::icon::%{_uuid}%::%{_official}%}
                set {_uncoloredRaw} to uncolored {_rawName}
                set {_suffix} to ""
                if {_uncoloredRaw} contains "(Current)":
                    set {_suffix} to " &a(Current)"
                set {_bracket} to {_uncoloredRaw}
                replace all " (Current)" with "" in {_bracket}
                replace regex "\].*$" in {_bracket} with "]"
                set {_newName} to "&6%{_bracket}% %{_display}%%{_suffix}%"
                set {_lore::*} to lore of {_item}
                set {_new} to charIconItem({_iconId})
                set name of {_new} to {_newName}
                if {_lore::*} is set:
                    set lore of {_new} to {_lore::*}
                set slot {_guiSlot} of {_p}'s current inventory to {_new}

# -------------------------------------------------------
#  Menus
# -------------------------------------------------------
function openCharMenu(p: player):
    if charHasProfile({_p}) is false:
        send "{@prefix}&cJoin a character first, then use this menu to switch, rename, or change its icon." to {_p}
        stop
    set {_inv} to chest inventory with 3 rows named {@menu-title}
    set {_uuid} to {_p}'s uuid
    set {_official} to charOfficialName({_p})
    set {_display} to charDisplayName({_p})
    set {_iconId} to charIconIdOf({_p})
    set {_class} to placeholder "mmocore_class" from {_p}
    set {_level} to placeholder "mmocore_level" from {_p}
    set {_slot} to placeholder "mmoprofiles_current_profile_slot" from {_p}
    set {_head} to charIconItem({_iconId})
    set name of {_head} to "&e&l%{_display}%"
    set lore of {_head} to "&7This is your current character." and "" and "&7Display name: &e%{_display}%" and "&7Internal name: &8%{_official}%" and "&7Slot: &e%{_slot}%" and "&7Class: &c%{_class}%" and "&7Level: &e%{_level}%" and "" and "&7Internal names are what MMOProfiles" and "&7stored at creation. Display names and" and "&7icons are applied on top in-game."
    set slot 4 of {_inv} to {_head}

    set {_list} to "&7This saves your inventory, class,||&7and progress, then opens character||&7selection so you can pick another||&7character or create a new one.|| ||&e► Click to continue.|| ||&7Your characters:"
    loop 15 times:
        set {_pn} to placeholder "mmoprofiles_profile_name_%loop-number%" from {_p}
        if {_pn} is set:
            if {_pn} is not "":
                if {_pn} does not contain "mmoprofiles_profile_name":
                    set {_dn} to charShownNameFor({_uuid}, {_pn})
                    if {_pn} is {_official}:
                        set {_list} to "%{_list}%||&a• %{_dn}% &7(current)"
                    else:
                        set {_list} to "%{_list}%||&8• &e%{_dn}%"
    set slot 11 of {_inv} to ender chest named "&d&lSwitch Character" with lore {_list}

    set {_iconName} to charIconLabel({_iconId})
    set slot 13 of {_inv} to name tag named "&e&lRename Character" with lore "&7Change the name shown in" and "&7character selection and menus." and "" and "&7Current: &e%{_display}%" and "&7Limit: {@min-name-length}-{@max-name-length} characters." and "&7Letters, numbers, spaces, - _ '" and "" and "&e► Click, then type a new name."
    set slot 15 of {_inv} to item frame named "&b&lChange Icon" with lore "&7Pick the item/head used for this" and "&7character in selection and menus." and "" and "&7Current: &e%{_iconName}%" and "" and "&e► Click to choose an icon."
    set slot 18 of {_inv} to arrow named "&7Back to Profile" with lore "&7Open the &e/p &7character menu."
    set slot 26 of {_inv} to barrier named "&c&lClose" with lore "&7Close this menu."
    open {_inv} to {_p}

function openSwitchConfirm(p: player):
    set {_inv} to chest inventory with 3 rows named {@confirm-title}
    set {_display} to charDisplayName({_p})
    set slot 11 of {_inv} to lime wool named "&a&lYes, switch characters" with lore "&7Saves &e%{_display}%" and "&7then opens character selection." and "" and "&7You will be moved to the" and "&7character-select area." and "" and "&a► Click to confirm."
    set slot 13 of {_inv} to paper named "&e&lWhat happens?" with lore "&7This uses MMOProfiles' official" and "&7quit command so your inventory," and "&7location, and class progress" and "&7are saved before unload." and "" and "&7Hot-swapping without quit is" and "&7not supported by MMOProfiles."
    set slot 15 of {_inv} to red wool named "&c&lCancel" with lore "&7Stay on this character."
    open {_inv} to {_p}

function openIconPicker(p: player):
    set {_inv} to chest inventory with 4 rows named {@icon-title}
    loop 27 times:
        set {_s} to loop-number - 1
        set {_id} to charIconIdFromSlot({_s})
        if {_id} is not "":
            set {_it} to charIconItem({_id})
            set {_label} to charIconLabel({_id})
            set name of {_it} to "&e%{_label}%"
            set lore of {_it} to "&7Click to use this icon" and "&7for your current character."
            set slot {_s} of {_inv} to {_it}
    set slot 31 of {_inv} to arrow named "&7Back" with lore "&7Return to character manager."
    open {_inv} to {_p}

# -------------------------------------------------------
#  Commands
# -------------------------------------------------------
command /characters:
    aliases: chars, switchprofile
    executable by: players
    description: Switch, rename, or change your character icon
    trigger:
        if {char::switching::%player's uuid%} is true:
            send "{@prefix}&cPlease wait, your character is still switching."
            stop
        openCharMenu(player)

command /renamecharacter:
    aliases: renamechar
    executable by: players
    description: Rename your current character
    trigger:
        if charHasProfile(player) is false:
            send "{@prefix}&cJoin a character first."
            stop
        if {char::awaiting-rename::%player's uuid%} is true:
            send "{@prefix}&7You are already renaming. Type the new name in chat, or &ccancel&7."
            stop
        set {_gen} to charBeginRename(player)
        wait {@rename-timeout} seconds
        charFinishRenameTimeout(player, {_gen})

command /changeicon:
    aliases: charicon
    executable by: players
    description: Change your current character icon
    trigger:
        if charHasProfile(player) is false:
            send "{@prefix}&cJoin a character first."
            stop
        openIconPicker(player)

# -------------------------------------------------------
#  GUI clicks
# -------------------------------------------------------
on inventory click:
    set {_title} to uncolored "%name of player's current inventory%"
    if {_title} is {@select-title}:
        wait 3 ticks
        charApplySelectOverlay(player)
        stop

    if {_title} is {@menu-title}:
        cancel event
        set {_slot} to event-slot
        if {_slot} is 11:
            close player's inventory
            wait 1 tick
            openSwitchConfirm(player)
        else if {_slot} is 13:
            close player's inventory
            set {_gen} to charBeginRename(player)
            wait {@rename-timeout} seconds
            charFinishRenameTimeout(player, {_gen})
        else if {_slot} is 15:
            close player's inventory
            wait 1 tick
            openIconPicker(player)
        else if {_slot} is 18:
            close player's inventory
            make player execute command "/p"
        else if {_slot} is 26:
            close player's inventory
        stop

    if {_title} is {@confirm-title}:
        cancel event
        set {_slot} to event-slot
        if {_slot} is 11:
            if {char::switching::%player's uuid%} is true:
                send "{@prefix}&cPlease wait, your character is still switching."
                close player's inventory
                stop
            if charHasProfile(player) is false:
                send "{@prefix}&cYou are already in character selection."
                close player's inventory
                stop
            if player is dead:
                send "{@prefix}&cYou cannot switch characters while dead."
                stop
            set {char::switching::%player's uuid%} to true
            close player's inventory
            send "{@prefix}&eSaving &f%charDisplayName(player)% &eand opening character selection..."
            wait {@switch-delay-ticks} ticks
            execute console command "mmoprofiles quit %name of player%"
            wait 10 seconds
            delete {char::switching::%player's uuid%}
        else if {_slot} is 15:
            close player's inventory
            wait 1 tick
            openCharMenu(player)
        stop

    if {_title} is {@icon-title}:
        cancel event
        set {_slot} to event-slot
        if {_slot} is 31:
            close player's inventory
            wait 1 tick
            openCharMenu(player)
            stop
        set {_id} to charIconIdFromSlot({_slot})
        if {_id} is "":
            stop
        if charHasProfile(player) is false:
            send "{@prefix}&cJoin a character first."
            close player's inventory
            stop
        set {_uuid} to player's uuid
        set {_official} to charOfficialName(player)
        set {char::icon::%{_uuid}%::%{_official}%} to {_id}
        play sound "block.note_block.pling" with volume 0.6 and pitch 1.2 to player
        set {_label} to charIconLabel({_id})
        send "{@prefix}&aIcon updated to &e%{_label}%&a."
        close player's inventory
        wait 1 tick
        openCharMenu(player)

# -------------------------------------------------------
#  Apply overlays when inventories open
# -------------------------------------------------------
on inventory open:
    set {_title} to uncolored "%name of event-inventory%"
    if {_title} is {@select-title}:
        wait 2 ticks
        charApplySelectOverlay(player)

# -------------------------------------------------------
#  Chat capture for rename
# -------------------------------------------------------
on chat:
    set {_uuid} to player's uuid
    if {char::awaiting-rename::%{_uuid}%} is not true:
        stop
    cancel event
    delete {char::awaiting-rename::%{_uuid}%}

    set {_input} to uncolored message
    replace all "§" with "" in {_input}
    replace all "&" with "" in {_input}
    replace regex "^\s+" in {_input} with ""
    replace regex "\s+$" in {_input} with ""
    replace regex "\s+" in {_input} with " "

    if {_input} is "cancel":
        send "{@prefix}&7Rename cancelled."
        stop

    if charHasProfile(player) is false:
        send "{@prefix}&cJoin a character before renaming."
        stop

    set {_len} to length of {_input}
    if {_len} < {@min-name-length}:
        send "{@prefix}&cName is too short. Minimum is {@min-name-length} characters."
        stop
    if {_len} > {@max-name-length}:
        send "{@prefix}&cName is too long. Maximum is {@max-name-length} characters."
        stop

    set {_safe} to {_input}
    replace regex "[^A-Za-z0-9 _'\-]" in {_safe} with ""
    if {_safe} is not {_input}:
        send "{@prefix}&cNames can only use letters, numbers, spaces, hyphens, underscores, and apostrophes."
        stop

    if charNameBlocked({_input}) is true:
        send "{@prefix}&cThat name is not allowed. Please choose another."
        stop

    set {_official} to charOfficialName(player)
    if charNameTaken(player, {_official}, {_input}) is true:
        send "{@prefix}&cYou already have a character with that name."
        stop

    if {char::display::%{_uuid}%::%{_official}%} is set:
        delete {char::official::%{_uuid}%::%{char::display::%{_uuid}%::%{_official}%}%}

    set {char::display::%{_uuid}%::%{_official}%} to {_input}
    set {char::official::%{_uuid}%::%{_input}%} to {_official}
    play sound "entity.player.levelup" with volume 0.5 and pitch 1.3 to player
    send "{@prefix}&aCharacter renamed to &e%{_input}%&a."
    send "{@prefix}&7This name is shown in character selection and menus. MMOProfiles still stores the original name internally."
    wait 5 ticks
    openCharMenu(player)

on join:
    delete {char::awaiting-rename::%player's uuid%}
    delete {char::switching::%player's uuid%}
